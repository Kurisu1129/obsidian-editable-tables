node_modules/
# Build output (esbuild `outfile: 'main.js'`), root only. Anchored with a leading slash so
# archived one-off probe plugins under .trellis/tasks/**/spikes/ stay tracked — losing them
# means losing the only record of how a spike's conclusions were obtained.
/main.js
*.js.map
.DS_Store

# Local verification artefacts
.shots/

# Locally built distributable packages (release assets are hosted on GitHub)
release/dist/

# Test vault: Obsidian's own mutable state, not project source
spike-vault/.obsidian/workspace.json
spike-vault/.obsidian/workspace-mobile.json
spike-vault/.obsidian/cache
spike-vault/.obsidian/plugins/
spike-vault/*.md
